{
  "name": "engineering-atlas",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "browser": "src/main.ts",
        "tsConfig": "tsconfig.app.json",
        "index": "src/index.html",
        "styles": [
          "src/styles.css"
        ],
        "outputPath": "dist/engineering-atlas",
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ]
      },
      "configurations": {
        "production": {
          "outputHashing": "all",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "650kB",
              "maximumError": "1MB"
            }
          ]
        },
        "development": {
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "engineering-atlas:build:development"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "tsconfig.spec.json",
        "runner": "vitest"
      }
    },
    "api-build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/api"
      ],
      "options": {
        "command": "dotnet publish api/EngineeringAtlas.Api.csproj --configuration Release --output dist/api"
      }
    },
    "api-test": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "dotnet test api.tests/EngineeringAtlas.Api.Tests.csproj --configuration Release"
      }
    }
  }
}
