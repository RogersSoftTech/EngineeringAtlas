{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "engineering-atlas",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "src/main.ts",
        "tsConfig": "tsconfig.app.json",
        "index": "src/index.html",
        "styles": [
          "src/styles.css"
        ],
        "outputPath": "dist/engineering-atlas",
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ]
      },
      "configurations": {
        "production": {
          "outputHashing": "all",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "650kB",
              "maximumError": "1MB"
            }
          ]
        },
        "development": {
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "engineering-atlas:build:development"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "tsconfig.spec.json",
        "runner": "vitest"
      }
    }
  }
}
